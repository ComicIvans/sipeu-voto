# ─── Deployment (used by deploy.sh on your local machine) ────────────────────
VPS_HOST=dockeruser@your-vps
REMOTE_DIR=/opt/sipeu-voto
# IMAGE_NAME=ghcr.io/comicivans/sipeu-voto
# IMAGE_TAG=<git-sha-or-custom-tag>
# SIPEU_VOTO_IMAGE=ghcr.io/comicivans/sipeu-voto:<tag>
DOCKER_PLATFORM=linux/amd64
APPLY_MIGRATIONS_ON_DEPLOY=true
# Images kept on the server after a deploy, and seconds to wait for /health
# before the deploy is considered failed (0 disables the check).
DEPLOY_IMAGE_RETENTION=2
DEPLOY_HEALTH_TIMEOUT=90
# Site URL baked into the build, when it differs from NUXT_SITE_URL
# NUXT_DEPLOY_SITE_URL=https://sipeu.wupp.dev
# Log in to GHCR from deploy.sh instead of doing it by hand
# GHCR_LOGIN=true
# GHCR_USERNAME=
# GHCR_TOKEN=
APP_PORT=3000
APP_DATA_DIR=./data

# ─── Application ─────────────────────────────────────────────────────────────
NUXT_SITE_URL=http://localhost:3000
# Overrides NUXT_SITE_URL as the origin Better Auth trusts. Leave unset.
# BETTER_AUTH_URL=
TZ=Atlantic/Canary
# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-secret

# First admin account, created automatically on boot if no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_FIRST_NAME=Organización
ADMIN_LAST_NAME=SIPEU

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Empty SMTP_HOST prints the credentials to the server console instead of
# sending them. For Mailpit use localhost:1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sipeu@example.com
SMTP_PASSWORD=change-me
MAIL_FROM="Votaciones SIPEU <sipeu@example.com>"

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=sipeu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sipeu
POSTGRES_PORT=5434
DATABASE_URL="postgresql://sipeu:change-me@localhost:5434/sipeu?schema=public"

# Local tooling
ADMINER_PORT=8090
# Mailpit (docker compose up mailpit): SMTP_HOST=localhost SMTP_PORT=1025, UI at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
